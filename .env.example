# Copy to .env. Sample mode stays on localhost and uses fictional data.
# Every mode requires a server-only CopilotKit Intelligence project key.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=http://localhost:11434/v1  # e.g., Ollama, llama.cpp, vLLM
# When using a local OpenAI-compatible backend, set:
# OPENAI_API_FORMAT=chat-completions  # Use Chat Completions API instead of Responses API
# Most local backends (Ollama, llama.cpp, LM Studio) only support chat-completions.
# vLLM 0.6+ supports both. Default is "responses" for OpenAI-hosted models.
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.
#
# Optional per-route model assignment for multi-model deployments:
#   CHAT_MODEL   — interactive chat (ConversationAgent, 6 steps, 9 tools)
#                  e.g. a 7B local model for mobile companions
#   TASK_MODEL   — complex durable tasks (task worker, 16 steps, 14+ tools)
#                  e.g. a 13B+ model for agent/document/plan tasks
#   SIMPLE_TASK_MODEL — simple task kinds (monitor, finance)
#                        falls back to CHAT_MODEL, then MODEL
# Each falls back to MODEL. If none are set, MODEL is used everywhere.
# CHAT_MODEL=openai/qwen3-8b
# TASK_MODEL=openai/qwen3-32b
# SIMPLE_TASK_MODEL=openai/qwen3-8b
# Optional per-route step limits (how many tool-call iterations each path gets):
#   CHAT_MAX_STEPS=6
#   TASK_MAX_STEPS=16
#   SIMPLE_TASK_MAX_STEPS=6
# Optional tool allowlist for the chat model — essential for 3B-9B LLMs that
# get confused by 12+ tools whose names differ only by prefix.
# Accepts exact names or prefix globs (e.g. "computer_*" matches all computer tools).
# Recommended minimal set for 3B-9B chat models:
#   CHAT_TOOL_ALLOWLIST=delegate_task,agent_status,remember_fact,search_mail,read_mail_thread,open_workspace
# Add "laya_*" to include Laya classification tools when LAYA_ENABLED=true.
# Full recommended set with Laya:
#   CHAT_TOOL_ALLOWLIST=delegate_task,agent_status,remember_fact,search_mail,read_mail_thread,open_workspace,laya_*
# Use exact tool names for computer tools since most use prefixes like start_computer,
# run_computer_command, etc. — not computer_*. Add "computer_*" to include computer_status.
# If unset, all tools are offered (default, best for 13B+ models).
#
# Per-device model routing overrides (mobile companion settings):
# Clients can PATCH /api/agent/device-models to set per-device model
# preferences that override the server defaults for that specific device.
# Keyed by deviceId sent during session creation (POST /api/session).
# { chatModel?, taskModel?, simpleTaskModel? }

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.
#
# Multi-device / cross-device deployment:
#   - Use DATABASE_URL to point all API and worker processes at a shared
#     PostgreSQL instance (local or Neon). Tasks, events, and memories are
#     keyed by owner, so any authenticated device sees the same data.
#   - Clients pass deviceId and deviceName when creating a session
#     (POST /api/session). The device info is stored on tasks as
#     state.creatorDevice so you can tell which device started a task.
# Task event streaming (SSE): GET /api/agent/tasks/:id/stream
# Returns existing run-events immediately, then polls every poll interval for
# new events until the task reaches a terminal status. Ideal for live
# cross-device status updates without polling.
# Default poll interval is 2000ms (2 seconds); increase for busy servers:
# STREAM_POLL_INTERVAL_MS=5000

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# CopilotKit Intelligence is required in every mode. Create or select a project
# with the commands below, then keep the generated key server-only.
# npx copilotkit@latest login
# npx copilotkit@latest project select
CPK_INTELLIGENCE_API_KEY=

# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t openmuse-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
# Stable deployment name shared by API and worker; defaults to a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=my-openmuse
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-openmuse
# Or run each owner's computer in an E2B Desktop sandbox instead of Docker
# (graphical desktop with internet access; see docs/COMPUTER.md):
# COMPUTER_PROVIDER=e2b-desktop  # default: docker
# E2B_API_KEY=  # server-only; required for e2b-desktop, never sent into the sandbox
# COMPUTER_DEPLOYMENT_ID is required for e2b-desktop: sandboxes are matched across the E2B team
# COMPUTER_E2B_TEMPLATE=desktop  # optional custom template built from "desktop"
# E2B_DOMAIN=  # only when not using the default E2B cluster

# Optional Laya file classification (host GPU via SSH tunnel). When enabled,
# the agent can classify workspace files without reading them into context —
# file content stays on disk and only the classification result (~60 bytes)
# is returned to the model. Saves ~1250 tokens per 5KB file vs. reading.
# Requires: laya-file-mcp project at LAYA_CLI_PATH with a working venv.
# LAYA_ENABLED=true
# LAYA_CLI_PATH=/home/ubuntu/laya-file-mcp/laya_cli.py
# LAYA_PYTHON_BIN=/home/ubuntu/.hermes/hermes-agent/venv/bin/python3
