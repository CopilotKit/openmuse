# OpenMuse — copy this file to `.env` and fill in your own values.
# Never commit a real `.env` with secrets.

# Deployment mode: live (real model + browser worker) or demo
WORKSPACE_MODE=live
AGENT_BACKEND=model

# LLM provider (any OpenAI-compatible endpoint works)
MODEL=openai/deepseek-chat
OPENAI_API_KEY=YOUR_LLM_API_KEY
OPENAI_BASE_URL=https://api.deepseek.com/v1

PORT=8787
HOST=0.0.0.0
# Public URL of the API, reachable from the dashboard:
PUBLIC_API_URL=http://YOUR_SERVER_HOST:8787

# Local data directory (sqlite/postgres files, session keys, screenshots)
DATA_DIR=./.openmuse

# Comma-separated dashboard origins allowed to call the API
ALLOWED_ORIGINS=http://YOUR_SERVER_HOST:8090,http://localhost:8090,http://127.0.0.1:8090

# Dashboard access key (generate a long random string)
OPENMUSE_ACCESS_KEY=YOUR_DASHBOARD_ACCESS_KEY

# Key used to encrypt stored connector tokens (base64, 32 bytes)
TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_TOKEN_ENCRYPTION_KEY

DO_NOT_TRACK=1
COPILOTKIT_TELEMETRY_DISABLED=true

# Browser worker (Playwright) endpoint + shared token
BROWSER_WORKER_URL=http://127.0.0.1:8790
WORKER_TOKEN=YOUR_BROWSER_WORKER_TOKEN

# Comma-separated domains the browser worker may treat as trusted
# (bypasses the public-IP/SSRF block for self-hosted services)
BROWSER_TRUSTED_DOMAINS=example.com

# Sandboxed Linux "computer" (docker) for terminal/filesystem tools
COMPUTER_ENABLED=true
COMPUTER_IMAGE=openmuse-computer:local

DATABASE_URL=postgres://openmuse:YOUR_DB_PASSWORD@localhost:5432/openmuse

# WhatsApp sidecar (optional)
WHATSAPP_SIDECAR_URL=http://127.0.0.1:8791
WHATSAPP_SIDECAR_TOKEN=YOUR_WHATSAPP_SIDECAR_TOKEN

# Local voice transcription (optional, whisper.cpp)
VOICE_TRANSCRIBER_BIN=/opt/whisper.cpp/bin/whisper-cli
VOICE_TRANSCRIBER_MODEL=/opt/whisper.cpp/models/ggml-tiny.bin
