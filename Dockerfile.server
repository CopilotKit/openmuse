# Docker image for the OpenMuse server (AG-UI API, task worker router).
# The browser worker and computer container are separate services.
FROM node:22.22.0-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash python3 git \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/openmuse /workspace \
    && chown 1000:1000 /workspace

WORKDIR /app
COPY package.json pnpm-lock.yaml ./
# Install only production deps to keep the image small
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate && pnpm install --frozen-lockfile --omit=dev --ignore-scripts
COPY --chown=1000:1000 apps/server/src ./apps/server/src
COPY --chown=1000:1000 packages ./packages
COPY --chown=1000:1000 tsconfig*.json ./

USER 1000:1000
ENV HOME=/workspace LANG=C.UTF-8
WORKDIR /app

EXPOSE 8787
CMD ["node", "--experimental-strip-types", "apps/server/src/index.ts"]
