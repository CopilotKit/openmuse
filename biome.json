{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.expo",
      "!**/dist",
      "!**/ios",
      "!**/android",
      "!**/.openmuse",
      "!**/artifacts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noEmptyPattern": "error",
        "noSelfAssign": "error",
        "noUnreachable": "error",
        "noUnusedInstantiation": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "useYield": "error",
        "noUnresolvedImports": "error",
        "noConstantCondition": "error",
        "noUnusedFunctionParameters": "error",
        "useJsxKeyInIterable": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off",
        "noDoubleEquals": "error",
        "noIrregularWhitespace": "error",
        "noMisleadingCharacterClass": "error",
        "noPrototypeBuiltins": "error",
        "noRedeclare": "error",
        "noSelfCompare": "error",
        "noShadow": "error",
        "noSparseArray": "error",
        "noTemplateCurlyInString": "error",
        "noThenProperty": "error",
        "noUnnecessaryConditions": "error",
        "noUnsafeNegation": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "noWith": "error",
        "noImportCycles": "error",
        "noEvolvingTypes": "error",
        "noGlobalAssign": "error",
        "useAwait": "off",
        "useErrorMessage": "error",
        "useGuardForIn": "error",
        "useIsArray": "error",
        "useIterableCallbackReturn": "error",
        "noImplicitAnyLet": "error",
        "noUnassignedVariables": "error",
        "noOctalEscape": "error",
        "noAsyncPromiseExecutor": "error",
        "noTsIgnore": "error",
        "noCommentText": "error",
        "noGlobalIsNan": "error",
        "noFunctionAssign": "error",
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateDependencies": "error",
        "noDuplicateParameters": "error",
        "noExtraNonNullAssertion": "error",
        "noHeadImportInDocument": "error",
        "noShadowRestrictedNames": "error",
        "useDefaultSwitchClauseLast": "error",
        "noDocumentCookie": "error",
        "noDuplicateFields": "error",
        "noDuplicateObjectKeys": "error",
        "noConfusingVoidType": "error",
        "noUselessEscapeInString": "error"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useNumericSeparators": "off",
        "useTemplate": "error",
        "useShorthandFunctionType": "error",
        "useNamingConvention": "off",
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useThrowOnlyError": "error",
        "useExplicitLengthCheck": "error",
        "noUselessElse": "error",
        "useConsistentArrayType": "error",
        "noUnusedTemplateLiteral": "error",
        "useDefaultParameterLast": "error"
      },
      "complexity": {
        "noUselessRename": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessFragments": "error",
        "noUselessReturn": "error",
        "noStaticOnlyClass": "error",
        "noFlatMapIdentity": "error",
        "useFlatMap": "error",
        "noUselessSwitchCase": "error",
        "noUselessThisAlias": "error"
      },
      "performance": {
        "noDelete": "error"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noStaticElementInteractions": "off",
        "noNoninteractiveTabindex": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**/*.ts", "**/test/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off",
            "noShadow": "off",
            "noExplicitAny": "warn",
            "noUnnecessaryConditions": "off"
          },
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnnecessaryConditions": "off",
            "noShadow": "off"
          }
        }
      }
    }
  ]
}
