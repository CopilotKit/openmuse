{
  "name": "openmuse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:demo": "tsx apps/server/src/demo/entry.ts",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "dev:web": "pnpm --dir apps/mobile web",
    "test": "tsx --test tests/*.test.ts apps/mobile/test/*.test.ts",
    "test:browser": "node --experimental-strip-types --test apps/worker/tests/lifecycle.test.ts",
    "typecheck": "tsc --noEmit && pnpm --dir apps/mobile typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/server/src/index.js",
    "build:web": "pnpm --dir apps/mobile build:web",
    "build:ios": "pnpm --dir apps/mobile build:ios",
    "build:android": "pnpm --dir apps/mobile build:android",
    "dev:worker": "tsx apps/server/src/worker-entry.ts",
    "start:worker": "node dist/apps/server/src/worker-entry.js",
    "dev:browser": "node --env-file=.env --import tsx apps/worker/src/index.ts",
    "test:computer": "tsx --test apps/computer/smoke.test.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@copilotkit/runtime": "1.73.1",
    "@electric-sql/pglite": "^0.3.14",
    "@hono/node-server": "^1.19.0",
    "ai": "6.0.282",
    "hono": "^4.11.4",
    "parse5": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "rxjs": "7.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@copilotkit/aimock": "1.42.0",
    "@copilotkit/core": "1.73.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
